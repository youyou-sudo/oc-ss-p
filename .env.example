# opencode-session-proxy - environment template
#
# Copy to .env and edit. Bun loads .env automatically:
#   cp .env.example .env
#
# Every value below is optional; the defaults shown are what the service uses
# when the variable is unset OR empty. Invalid values fail fast at boot.


# --- Server ---------------------------------------------------------------

# Port this proxy listens on.
PORT=8787

# Interface to bind. 127.0.0.1 keeps it local-only; 0.0.0.0 exposes it.
HOST=127.0.0.1


# --- Upstream -------------------------------------------------------------

# Base URL of the real OpenCode inference endpoint.
UPSTREAM=https://opencode.ai


# --- Paths ----------------------------------------------------------------

# Rewrite the family-less inference paths onto OpenCode's canonical
# API-family paths:
#   /inference/v1/chat/completions  -> /inference/openai/v1/chat/completions
#   /inference/v1/messages          -> /inference/anthropic/v1/messages
#   /inference/v1beta/models/...    -> /inference/google/v1beta/models/...
# /inference/v1/models is a documented endpoint and is never rewritten.
# Leave empty for the default (on). Set to 0 to forward paths untouched.
CANONICALIZE_PATHS=


# --- Egress proxy (hides this server's IP from opencode) --------------------

# Comma or newline separated pool. Each entry is `url` or `url#label`, where
# #label only shows up in VERBOSE logs.
#
# Only http:// and https:// work. Bun's fetch rejects socks5://, socks5h:// and
# socks4:// with UnsupportedProxyProtocol, and this proxy refuses to start on
# those so it can never silently fall back to a direct connection.
#
# https:// upstreams tunnel through the proxy using CONNECT.
# PROXIES=http://user:pass@host1:8080#alpha,http://user:pass@host2:8080#beta

# Which hop a request uses:
#   stable      - one exit IP per conversation (default; a stable identity is
#                 less suspicious than one that moves between turns)
#   round-robin - cycle through the pool
#   random      - pick randomly
# Leave empty for the default.
EGRESS_STRATEGY=


# --- Fingerprint ----------------------------------------------------------
# Left unset, user-agent + x-opencode-client are derived as a pair per
# conversation, and the session suffix is derived per conversation: stable for
# that conversation, unrelated across conversations.
#
# OpenCode sends one identity across the two headers and they have to agree:
#   user-agent:        opencode/<channel>/<version>/<name>
#   x-opencode-client: <name>
# so the two are always derived together here. Set them to pin a fixed value
# instead.

# Pin the user-agent (overrides the fingerprint). The client tag is read back
# out of it, so the pair stays consistent.
# USER_AGENT=opencode/latest/2.0.29/cli

# Pin the x-opencode-client tag (overrides the fingerprint). The generated
# user-agent uses this tag.
# CLIENT=cli


# --- Session id -----------------------------------------------------------
# Format is strict: ses_ + 12 hex + exactly 14 base62. The 12 hex chars are the
# low 48 bits of ~(Date.now() * 4096 + counter) — the descending encoding the
# official client uses (packages/schema/src/identifier.ts). A malformed
# SESSION_PREFIX is rejected at boot.

# Pin one 12-hex prefix for every conversation. Left empty (the default), a
# prefix is minted per conversation, so the clock inside it is the moment that
# conversation started instead of a constant frozen months ago.
# SESSION_PREFIX=ses_ecbe61115ffe

# Mint a fresh prefix per request instead of per conversation. Each request
# then looks like a freshly started CLI, but it also breaks the gateway's
# per-session routing and prompt-cache affinity, so it is usually worse.
# ROTATE_SESSION_PREFIX=1

# Counter embedded in the prefix: the per-millisecond id increment, 12 bits
# (1..4095). A freshly started client uses 1.
# SESSION_COUNTER=1


# --- Logging --------------------------------------------------------------

# Log one line per request: METHOD path -> session via <proxy label>.
# Uncomment while setting things up; the default is off.
# VERBOSE=1
